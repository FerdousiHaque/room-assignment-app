rules_version = '2';

// Access model (Firebase Authentication):
//   * Everyone must be signed in to read anything (admin, or a team member
//     who used "As a team member" = anonymous sign-in).
//   * ADMIN = an email/password account whose email is listed in
//     isAdmin() below. Admins can write everything (providers, rooms, days).
//   * TEAM MEMBERS (anonymous) can only write the daily upload documents
//     (appState/day-YYYY-MM-DD) — they can import/export but can never
//     change providers or rooms.
//
// >>> SET YOUR ADMIN EMAIL(S) in isAdmin() before this is deployed. <<<
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in ['REPLACE_WITH_ADMIN_EMAIL'];
    }

    match /appState/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && docId.matches('day-.*'));
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
